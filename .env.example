# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Compose PostgreSQL password. Use URL-safe ASCII (letters, numbers, _, -).
# Compose constructs the internal DATABASE_URL from this value.
# Keep it stable while the local PostgreSQL volume exists; changing it in .env
# does not update the password stored by PostgreSQL.
GASTTO_LOCAL_DB_PASSWORD=

# Host-side tools only. Local Compose overrides this with postgres:5432.
# Leave empty unless running tools outside Compose against an explicitly chosen DB.
DATABASE_URL=

# Host-side processes only. Local Compose overrides this with redis:6379.
# Use redis://localhost:6379 only if running the legacy Redis-only workflow.
REDIS_URL=

# Category classification (E1-US-04)
# Minimum confidence for keyword-based category classification. Range: [0, 1]. Default: 0.6.
CATEGORY_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6

# LLM
LLM_PROVIDER=auto
LLM_FALLBACK_PROVIDER=auto
LLM_EXTRACTION_TIMEOUT_MS=30000
# At least one provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Semantic router shadow pipeline (off by default)
# Example when explicitly sampling IDLE: IDLE=shadow,EXPENSE_RECEIVING=shadow
SEMANTIC_ROUTER_STATE_MODES=
SEMANTIC_ROUTER_COHORT_PERCENT=0
SEMANTIC_ROUTER_SHADOW_SAMPLE_PERCENT=0
SEMANTIC_ROUTER_COHORT_SEED=gastto-semantic-router-v1
SEMANTIC_ROUTER_PROVIDER=openai
SEMANTIC_ROUTER_MODEL=gpt-4o-mini-2024-07-18
# Must remain below the 30000 ms per-user lock renewal interval.
SEMANTIC_ROUTER_TIMEOUT_MS=10000
SEMANTIC_ROUTER_MAX_OUTPUT_TOKENS=256

# Messaging
# Compose enables the tunnel by default. For a core-only run, also use
# compose.local.core.yml as an override (see docs/development/local-setup.md).
COMPOSE_PROFILES=tunnel
# Obtain the authtoken and assigned development domain from your ngrok account.
NGROK_AUTHTOKEN=
# Generate from 32 random bytes; allowed alphabet A-Z a-z 0-9 _ -, length 32–256.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
# Base URL where the Telegram webhook is reachable (e.g. https://gastto-develop.fly.dev).
# Used to auto-register the webhook with Telegram Bot API on startup.
# For the default local Compose tunnel use https://<your-assigned-ngrok-domain>.
# Core-only runs may use http://localhost:3000 (webhook registration is skipped).
WEBHOOK_BASE_URL=

# Observability
SENTRY_DSN=

# OAuth
# Register the exact URI in Google Auth platform > Clients > Authorized redirect URIs.
# Use localhost only when completing consent on the Docker host. On a phone use
# https://<your-assigned-development-domain>/auth/google/callback instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Telegram access approval. Enable only after the separate operator Gmail OAuth
# client is published appropriately and its refresh grant has been tested.
ACCESS_APPROVAL_ENABLED=false
ADMIN_NOTIFICATION_EMAIL=
ADMIN_GMAIL_ADDRESS=
ADMIN_GMAIL_CLIENT_ID=
ADMIN_GMAIL_CLIENT_SECRET=
ADMIN_GMAIL_REFRESH_TOKEN=

# Security
# AES-256-GCM key for OAuth token encryption (ADR-007). Must be 32 bytes (64 hex chars).
ENCRYPTION_KEY=

# HTTP security budgets (socket peer, forwarding headers ignored)
SECURITY_RATE_WINDOW_MS=60000
SECURITY_TELEGRAM_LIMIT=60
SECURITY_OAUTH_LIMIT=60
