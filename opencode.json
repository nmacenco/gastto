{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
   "permission": {
    "lsp": "allow", 
    "skill": "allow"
  },
   "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx", ".json", ".jsonc", ".md", ".yaml", ".yml"]
    }
  }
}