{
  "name": "gastto",
  "version": "0.1.0",
  "description": "Asistente financiero conversacional — WhatsApp & Telegram → Google Sheets / Excel Online",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts src/interfaces/cli/approveAccessRequest.ts src/interfaces/cli/notifyAccessRequest.ts --format cjs --dts --clean",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:semantic-router": "tsx src/interfaces/cli/evaluateSemanticRouter.ts",
    "eval:semantic-router:release": "tsx src/interfaces/cli/evaluateSemanticRouterRelease.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "redis:up": "docker-compose up -d",
    "redis:down": "docker-compose down",
    "redis:logs": "docker-compose logs -f",
    "redis:clean": "docker-compose down -v",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "security:audit": "node scripts/security/audit.mjs",
    "security:test": "node --test scripts/security/*.test.mjs",
    "security:audit:all": "node scripts/security/audit.mjs --all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sentry/node": "^11.10.0",
    "bullmq": "^5.81.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "googleapis": "^189.0.0",
    "ioredis": "^5.11.1",
    "isomorphic-fetch": "^3.0.0",
    "openai": "^7.47.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
